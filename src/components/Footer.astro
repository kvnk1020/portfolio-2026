---
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface">
	<div class="mx-auto flex max-w-6xl flex-col gap-10 px-6 py-16 md:flex-row md:items-end md:justify-between md:px-12">
		<div>
			<h2 class="text-2xl font-semibold tracking-tight text-ink md:text-3xl">
				Interested? Let's get in touch!
			</h2>
			<div class="mt-6 flex items-center gap-8 text-sm text-ink">
				<a href="#" class="inline-flex items-center gap-1 transition-colors hover:text-accent">
					Email
					<span aria-hidden="true">↗</span>
				</a>
				<a href="#" class="inline-flex items-center gap-1 transition-colors hover:text-accent">
					LinkedIn
					<span aria-hidden="true">↗</span>
				</a>
			</div>
		</div>
		<p class="text-sm text-ink-muted">©{year} Kevin Ku. All Rights Reserved.</p>
	</div>
</footer>
