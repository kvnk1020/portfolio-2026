---
interface Props {
  label: "Problem" | "Action" | "Result";
  subhead: string;
  body: string;
}

const { label, subhead, body } = Astro.props;

const icons: Record<Props["label"], string> = {
  Problem: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><circle cx="12" cy="12" r="9" /><line x1="12" y1="7.5" x2="12" y2="13" /><circle cx="12" cy="16.5" r="0.75" fill="currentColor" stroke="none" /></svg>`,
  Action: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><rect x="3" y="3" width="6" height="6" rx="1" /><rect x="15" y="15" width="6" height="6" rx="1" /><rect x="15" y="3" width="6" height="6" rx="1" /><path d="M9 6h3a3 3 0 0 1 3 3v3" /><path d="M18 9v3" /></svg>`,
  Result: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M12 3l7 3v5c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6l7-3z" /><path d="M9 12l2 2 4-4" /></svg>`,
};
---

<div class="rounded-2xl border border-border p-6 md:p-8">
	<div class="flex h-10 w-10 items-center justify-center rounded-full bg-accent-soft text-accent" set:html={icons[label]} />
	<h3 class="mt-5 text-lg font-semibold text-ink md:text-xl">
		<span class="text-accent">{label}:</span> {subhead}
	</h3>
	<p class="mt-3 leading-relaxed text-ink-muted">{body}</p>
</div>
